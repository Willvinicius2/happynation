# HAPPYNATIONBOT - Exemplo de Configuração
# Copie este arquivo para '.env' e preencha seus dados

# ==========================================
# BINANCE API - OBRIGATÓRIO
# ==========================================
BINANCE_API_KEY=sua_api_key_aqui
BINANCE_SECRET_KEY=sua_secret_key_aqui

# ==========================================
# TELEGRAM - OPCIONAL
# Deixe em branco se não quiser notificações
# ==========================================
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# ==========================================
# MODO DE OPERAÇÃO
# ==========================================
# true = Simula com dados reais (SEM dinheiro real)
# false = Trading real com sua conta
PAPER_TRADING=true

# ==========================================
# EXEMPLOS (DESCOMENTE PARA USAR)
# ==========================================

# Exemplo Telegram:
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=123456789
