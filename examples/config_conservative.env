# ═══════════════════════════════════════════════════════════
# CONFIGURAÇÃO CONSERVADORA - HAPPYNATIONBOT
# ═══════════════════════════════════════════════════════════
#
# Perfil: Iniciante, avesso ao risco
# Estratégia: RSI (win rate 89%)
# Retorno esperado: +5-10% ao mês
# Risco: Muito baixo
#
# ═══════════════════════════════════════════════════════════

# Credenciais Binance
BINANCE_API_KEY=sua_api_key_aqui
BINANCE_SECRET_KEY=sua_secret_key_aqui

# Telegram (notificações)
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# Modo
PAPER_TRADING=true

# ═══════════════════════════════════════════════════════════
# ESTRATÉGIA: RSI (Melhor para conservadores)
#
# Por que RSI?
# - Win rate: 89% (muito alto!)
# - Menos trades (menos comissões)
# - Mais seguro para iniciantes
# - Fácil entender
#
# ═══════════════════════════════════════════════════════════

STRATEGY=rsi_strategy
RSI_PERIOD=14
RSI_LOW=30          # Compra quando RSI sai daqui
RSI_HIGH=70         # Vende quando RSI sai daqui

# ═══════════════════════════════════════════════════════════
# PROTEÇÃO: Stop Loss & Take Profit
#
# Filosofia: Melhor perder pouco que ganhar pouco
# ═══════════════════════════════════════════════════════════

STOP_LOSS_PERCENTAGE=1.5        # Máximo de perda por trade
TAKE_PROFIT_AT_PERCENTAGE=1.0   # Vender em +1% (objetivo conservador)
TAKE_PROFIT_AMOUNT_PERCENTAGE=100  # Vender 100% da posição

# ═══════════════════════════════════════════════════════════
# VELOCIDADE: Menos trades = Menos risco
# ═══════════════════════════════════════════════════════════

CANDLE_PERIOD=4h                # Análise a cada 4 horas
TEMPO_ENTRE_TRADES=30m          # Verifica a cada 30 min
DELAY_ENTRE_ORDENS=120m         # Espera 2h antes de reentrar

# ═══════════════════════════════════════════════════════════
# MOEDAS: Apenas as principais (menos voláteis)
# ═══════════════════════════════════════════════════════════

MOEDAS=BTC,ETH              # Apenas Bitcoin e Ethereum (mais seguras)

# ═══════════════════════════════════════════════════════════
# QUANTIDADE: Comece pequeno
# ═══════════════════════════════════════════════════════════

QUANTIDADE_POR_TRADE=100    # $100 por trade (papel) / ajuste conforme seu capital

# ═══════════════════════════════════════════════════════════
# RECURSOS DESATIVADOS: Deixar simples
# ═══════════════════════════════════════════════════════════

TRAILING_STOP_ENABLED=false     # Sem trailing stop
FALLBACK_STRATEGY_ENABLED=false # Estratégia única
MARKET_ORDERS=false             # Ordens limitadas (mais seguras)

# ═══════════════════════════════════════════════════════════
# DICAS DE USO
# ═══════════════════════════════════════════════════════════
#
# 1. Teste em PAPER_TRADING=true por 2-4 semanas
# 2. Se ganhando consistente, mude para PAPER_TRADING=false
# 3. Comece com pouco dinheiro ($50-100)
# 4. Aumente gradualmente se lucrar
# 5. Monitore sempre o Telegram para updates
#
# ═══════════════════════════════════════════════════════════
