# ═══════════════════════════════════════════════════════════
# CONFIGURAÇÃO SCALPING - HAPPYNATIONBOT
# ═══════════════════════════════════════════════════════════
#
# Perfil: Trader ativo, quer ganhos rápidos
# Estratégia: HighWinRateScalp (pequenos ganhos frequentes)
# Retorno esperado: +0.3-0.5% por trade (muitos trades)
# Risco: Médio (muitas operações = mais comissões)
#
# 📊 Exemplo: 10 trades/dia × 0.4% = 4% dia (118% mês!)
#
# ═══════════════════════════════════════════════════════════

# Credenciais Binance
BINANCE_API_KEY=sua_api_key_aqui
BINANCE_SECRET_KEY=sua_secret_key_aqui

# Telegram (notificações)
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# Modo
PAPER_TRADING=true

# ═══════════════════════════════════════════════════════════
# ESTRATÉGIA: HighWinRateScalp (Ganhos rápidos)
#
# Por que Scalp?
# - Ganho rápido (0.3-0.5% por trade)
# - Menos exposição (trade curto)
# - Muitas oportunidades por dia
# - Requer atenção CONSTANTE
#
# ═══════════════════════════════════════════════════════════

STRATEGY=high_win_rate_scalp
SCALP_TAKE_PROFIT_PCT=0.4       # Sai em +0.4%
SCALP_STOP_LOSS_PCT=1.5         # Perde máximo 1.5%
SCALP_RSI_MIN=38.0              # RSI mínimo
SCALP_RSI_MAX=62.0              # RSI máximo
SCALP_PULLBACK_PCT=0.2          # Espera pullback 0.2%

# ═══════════════════════════════════════════════════════════
# PROTEÇÃO: Stops apertados (scalp)
# ═══════════════════════════════════════════════════════════

STOP_LOSS_PERCENTAGE=1.5        # Sai rápido
TAKE_PROFIT_AT_PERCENTAGE=0.4   # Pequeno ganho por trade
TAKE_PROFIT_AMOUNT_PERCENTAGE=100  # Sai tudo

# ═══════════════════════════════════════════════════════════
# VELOCIDADE: MUITO RÁPIDO
#
# ⚠️ IMPORTANTE: Scalp precisa de:
# - Internet rápida
# - Conexão Binance estável
# - Monitoramento 24/7
#
# ═══════════════════════════════════════════════════════════

CANDLE_PERIOD=5m                # Análise a cada 5 MINUTOS (não horas!)
TEMPO_ENTRE_TRADES=30s          # Verifica a cada 30 segundos
DELAY_ENTRE_ORDENS=300s         # Espera 5 min antes de reentrar

# ═══════════════════════════════════════════════════════════
# MOEDAS: Apenas as mais voláteis e liquidas
# ═══════════════════════════════════════════════════════════

MOEDAS=BTC,ETH                  # Apenas 2 - high volume, high volatility

# ═══════════════════════════════════════════════════════════
# QUANTIDADE: Pequeno por trade (muitos trades!)
# ═══════════════════════════════════════════════════════════

QUANTIDADE_POR_TRADE=50         # $50 por trade (mas ~20 trades/dia)

# ═══════════════════════════════════════════════════════════
# RECURSOS: Otimizado para velocidade
# ═══════════════════════════════════════════════════════════

TRAILING_STOP_ENABLED=false     # Sem trailing (sai rápido mesmo)
FALLBACK_STRATEGY_ENABLED=false # Estratégia única = simpleza
MARKET_ORDERS=true              # OBRIGATÓRIO: executar rápido
EXECUTE_MARKET_ORDERS=true      # Market orders only

# ═══════════════════════════════════════════════════════════
# DICAS DE USO
# ═══════════════════════════════════════════════════════════
#
# 1. Teste em PAPER_TRADING=true por 2-3 semanas INTENSO
# 2. Monitore pelo Telegram durante todo dia
# 3. Se +10% por semana em paper, teste real com $100
# 4. Comissões são ALTAS - calcule: (0.4% ganho - 0.1% comissão = 0.3%)
# 5. Melhor rodar entre 8h-18h (horário NY para Bitcoin)
# 6. Final de semana = menos liquidez = risco maior
#
# 💡 REALITY CHECK:
#    10 trades/dia × 0.3% líquido = 3%/dia
#    3% × 20 dias = 60%/mês (muito bom!)
#    Mas: 1 dia ruim = perder tudo
#
# ═══════════════════════════════════════════════════════════
