# ═══════════════════════════════════════════════════════════
# CONFIGURAÇÃO AGRESSIVA - HAPPYNATIONBOT
# ═══════════════════════════════════════════════════════════
#
# Perfil: Trader experiente, tolerância ao risco
# Estratégia: Vortex (ROI +23.41%)
# Retorno esperado: +20-50% ao mês
# Risco: Alto
#
# ⚠️ CUIDADO: Maior potencial de lucro = Maior risco de perda
#
# ═══════════════════════════════════════════════════════════

# Credenciais Binance
BINANCE_API_KEY=sua_api_key_aqui
BINANCE_SECRET_KEY=sua_secret_key_aqui

# Telegram (notificações)
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# Modo
PAPER_TRADING=true

# ═══════════════════════════════════════════════════════════
# ESTRATÉGIA: Vortex (Melhor ROI: +23.41%)
#
# Por que Vortex?
# - Maior retorno em 90 dias
# - Mais trades (mais oportunidades)
# - Ótimo para mercados voláteis
# - Requer monitoramento ativo
#
# ═══════════════════════════════════════════════════════════

STRATEGY=vortex_strategy
VORTEX_PERIOD=14

# ═══════════════════════════════════════════════════════════
# PROTEÇÃO: Stop Loss & Take Profit
#
# Filosofia: Lucro máximo com proteção
# ═══════════════════════════════════════════════════════════

STOP_LOSS_PERCENTAGE=3.0        # 3% de perda (maior tolerância)
TAKE_PROFIT_AT_PERCENTAGE=2.0   # Vender em +2% (objetivo mais agressivo)
TAKE_PROFIT_AMOUNT_PERCENTAGE=100  # Vender 100% da posição

# ═══════════════════════════════════════════════════════════
# VELOCIDADE: Mais trades = Mais oportunidades
# ═══════════════════════════════════════════════════════════

CANDLE_PERIOD=1h                # Análise a cada hora
TEMPO_ENTRE_TRADES=10m          # Verifica a cada 10 min
DELAY_ENTRE_ORDENS=60m          # Espera 1h antes de reentrar

# ═══════════════════════════════════════════════════════════
# MOEDAS: Portfolio diversificado (mais trades)
# ═══════════════════════════════════════════════════════════

MOEDAS=BTC,ETH,SOL,XRP,ADA      # 5 moedas = 5x oportunidades

# ═══════════════════════════════════════════════════════════
# QUANTIDADE: Mais agressivo
# ═══════════════════════════════════════════════════════════

QUANTIDADE_POR_TRADE=300        # $300 por trade (ajuste conforme capital)

# ═══════════════════════════════════════════════════════════
# RECURSOS ATIVADOS: Otimizar ganhos
# ═══════════════════════════════════════════════════════════

TRAILING_STOP_ENABLED=true      # Protege lucros crescentes
TRAILING_STOP_PERCENTAGE=3.0    # Segue 3% atrás do pico
FALLBACK_STRATEGY_ENABLED=true  # Estratégia reserva quando principal não sinala
MARKET_ORDERS=true              # Ordens de mercado (executam rápido)

# ═══════════════════════════════════════════════════════════
# DICAS DE USO
# ═══════════════════════════════════════════════════════════
#
# 1. Teste em PAPER_TRADING=true por 4-8 semanas
# 2. Analise os lucros consistentemente
# 3. Se ganhando +20% mês, pode ativar PAPER_TRADING=false
# 4. Comece com capital pequeno ($500+)
# 5. Monitore ativamente - essa estratégia é mais ativa
# 6. Ajuste STOP_LOSS conforme sua tolerância
#
# ⚠️ LEMBRE-SE: Maior retorno = Maior risco
#
# ═══════════════════════════════════════════════════════════
